<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visual Dice Roller</title>
    <style>
        /* CSS Codes to style the game area */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1e1e24;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .game-container {
            background-color: #2a2b3d;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            text-align: center;
            width: 300px;
        }

        h1 {
            margin-bottom: 30px;
            font-size: 24px;
            letter-spacing: 1px;
        }

        /* The Dice Visual Area */
        .dice-box {
            width: 120px;
            height: 120px;
            background-color: #e63946;
            color: white;
            font-size: 64px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 30px auto;
            border-radius: 18px;
            box-shadow: inset 0 -8px 0 rgba(0,0,0,0.2), 0 5px 15px rgba(230, 57, 70, 0.4);
            transition: transform 0.1s ease;
        }

        /* Styling the button */
        button {
            background-color: #4caf50;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 4px 0 #388e3c;
            width: 100%;
            transition: all 0.1s ease;
        }

        button:active {
            transform: translateY(4px);
            box-shadow: none;
        }
    </style>
</head>
<body>

    <!-- HTML Layout for the Game Area -->
    <div class="game-container">
        <h1>Dice Simulator</h1>
        
        <!-- Displays the number sent dynamically from Python -->
        <div class="dice-box">
            {{ dice_value }}
        </div>

        <!-- Form that sends a POST request to Python when clicked -->
        <form method="POST">
            <button type="submit">Roll Dice 🎲</button>
        </form>
    </div>

</body>
</html>
